# Скопируйте в .env и при необходимости измените значения.
# cp .env.example .env

# Ollama: базовый URL API
OLLAMA_URL=http://localhost:11434

# Имя модели (должна быть загружена в Ollama, например: ollama pull llama3.1)
OLLAMA_MODEL=llama3.1

# Таймаут HTTP-запроса к Ollama (секунды)
LLM_TIMEOUT_SECONDS=10.0

# Температура генерации
OLLAMA_TEMPERATURE=0.1

# Максимальная длина ответа модели (токены)
OLLAMA_NUM_PREDICT=60

# JSON со шаблонами событий для POST /events/random
PATH_EVENT=data/events.json
